    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "cypress": "^15.8.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "react-test-renderer": "19.1.0",
    "start-server-and-test": "^2.1.3",
    "typescript": "~5.9.2"
